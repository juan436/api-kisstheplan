# ============================================================
# KissthePlan Backend — Variables de entorno
# ============================================================
# COPIA este archivo a ".env" y completa los valores reales.
# NUNCA hagas commit del archivo .env.
# ============================================================

# --- Servidor ---
PORT=3001

# --- Base de datos ---
MONGODB_URI=mongodb://kisstheplan_user:PASSWORD@kisstheplan-mongodb:27017/kisstheplan?authSource=admin

# --- JWT ---
JWT_SECRET=CAMBIA_ESTE_JWT_SECRET_MUY_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=CAMBIA_ESTE_JWT_REFRESH_SECRET_MUY_LARGO
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- CORS (URL pública del frontend) ---
# Para múltiples orígenes separa con coma: https://kisstheplan.es,http://localhost:3000
CORS_ORIGIN=https://kisstheplan.com

# --- Traefik (dominio público del backend) ---
BACKEND_DOMAIN=api.kisstheplan.com

# --- URLs de archivos estáticos ---
# URL base de la API para generar URLs absolutas de uploads
# En producción: https://api.kisstheplan.es (sin /api al final)
# En desarrollo: http://localhost:3001
API_BASE_URL=api.kisstheplan.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://api.kisstheplan.es/api/auth/google/callback

# --- Frontend URL (para redirect OAuth) ---
FRONTEND_URL=https://kisstheplan.es

# --- Mailer (Gmail App Password) ---
# Cuenta Gmail que envía los emails
MAIL_USER=tu-cuenta@gmail.com
# App Password de 16 caracteres generada en Google Account > Seguridad > Contraseñas de aplicación
MAIL_PASS=xxxx xxxx xxxx xxxx
